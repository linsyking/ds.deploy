def redact_log_records():
    # Also runs when multiprocessing imports this entrypoint in child processes.
    if not API_KEY.exists():
        return
    key = API_KEY.read_text().strip()
    if not key:
        return
    class RedactedStream:
        def __init__(self, stream):
            self.stream = stream
        def write(self, value):
            self.stream.write(value.replace(key, '<redacted>'))
            return len(value)
        def flush(self):
            return self.stream.flush()
        def __getattr__(self, name):
            return getattr(self.stream, name)
    sys.stderr = RedactedStream(sys.stderr)
    sys.stdout = RedactedStream(sys.stdout)
    previous = logging.getLogRecordFactory()
    def factory(*args, **kwargs):
        record = previous(*args, **kwargs)
        message = record.getMessage()
        if key in message:
            record.msg = message.replace(key, '<redacted>')
            record.args = ()
        return record
    logging.setLogRecordFactory(factory)


redact_log_records()


def config():
    cfg = json.loads(CONFIG_PATH.read_text())
    if cfg['host'] != '10.78.202.32' or cfg['hostname'] != 's04-p1-dgx-02-c04':
        raise RuntimeError('This controller is scoped to c04 only')
    if not 0 < cfg['mem_fraction_static'] < 1:
        raise ValueError('mem_fraction_static must be between zero and one')
    if cfg['chunked_prefill_size'] <= 0 or cfg['chunked_prefill_size'] % 256:
        raise ValueError('chunked_prefill_size must be a positive multiple of 256')
    return cfg


def on_server(cfg):
    return socket.gethostname().split('.')[0] == cfg['hostname']


def run(command, **kwargs):
    return subprocess.run([str(v) for v in command], check=True, text=True, **kwargs)


def tmux(*args, check=True, capture=False):
    return subprocess.run([TMUX, '-S', str(SOCKET), *map(str, args)], check=check,
                          text=True, stdout=subprocess.PIPE if capture else subprocess.DEVNULL,
                          stderr=subprocess.PIPE if capture else subprocess.DEVNULL)


def session_exists():
    return tmux('has-session', '-t', SESSION, check=False).returncode == 0


def proc_info(pid):
    try:
        fields = Path(f'/proc/{pid}/stat').read_text().rpartition(')')[2].split()
        return {'pid': int(pid), 'state': fields[0], 'pgid': int(fields[2]), 'start_ticks': fields[19]}
    except (FileNotFoundError, ProcessLookupError, PermissionError):
        return None


def group_members(pgid):
    found = []
    for path in Path('/proc').iterdir():
        if path.name.isdigit():
            item = proc_info(path.name)
            if item and item['pgid'] == pgid and item['state'] != 'Z':
                found.append(item)
    return found


def tracked_state():
    return json.loads(STATE.read_text()) if STATE.exists() else None


def state_is_alive(state):
    if not state:
        return False
    info = proc_info(state['pid'])
    return bool(info and info['state'] != 'Z' and info['start_ticks'] == state['start_ticks'])


@contextlib.contextmanager
def locked():
    RUNS.mkdir(exist_ok=True)
    with (RUNS / 'controller.lock').open('a') as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield


def request(cfg, path, timeout=5):
    req = urllib.request.Request(f'http://{cfg["host"]}:{cfg["port"]}{path}', headers=auth_headers())
    with OPENER.open(req, timeout=timeout) as response:
        return response.read()


def healthy(cfg):
    try:
        request(cfg, '/health', timeout=3)
        return True
    except (OSError, urllib.error.URLError):
        return False


def sync(cfg):
    if on_server(cfg):
        print('Already on c04; runtime files are local.')
        return
    run(['ssh', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10', cfg['host'],
         shlex.join(['mkdir', '-p', str(ROOT)])], timeout=15)
    files = [ROOT / name for name in RUNTIME_FILES if (ROOT / name).exists()]
    run(['scp', '-q', *files, f'{cfg["host"]}:{ROOT}/'], timeout=60)
    run(['ssh', '-o', 'BatchMode=yes', cfg['host'],
         shlex.join(['chmod', '+x', str(ROOT / 'ds41ctl'), str(ROOT / 'sglang_load.py')])], timeout=15)
    print('Runtime files synchronized to c04; model weights and environments are untouched.')


def preflight(cfg):
    python = ROOT / '.venvs/sglang/bin/python'
    for path in [python, Path(TMUX), AUTH_CONFIG, API_KEY, Path(cfg['model_path']) / '.checkpoint-verified.json']:
        if not path.exists():
            raise RuntimeError(f'Required file is missing: {path}')
    probe = socket.socket()
    try:
        probe.settimeout(1)
        if probe.connect_ex((cfg['host'], cfg['port'])) == 0:
            raise RuntimeError('The configured port is already occupied by an untracked service')
    finally:
        probe.close()
    diagnostic = run(['nvidia-smi', '-q', '-x'], capture_output=True, timeout=10)
    gpus = ET.fromstring(diagnostic.stdout).findall('gpu')
    if len(gpus) != 4:
        raise RuntimeError(f'Expected four GPUs on c04; found {len(gpus)}')
    for index, gpu in enumerate(gpus):
        action = gpu.findtext('gpu_recovery_action', 'Unknown')
        if action != 'None':
            raise RuntimeError(f'GPU {index} recovery action is {action}; refusing to launch')
    busy = run(['nvidia-smi', '--query-compute-apps=pid,process_name', '--format=csv,noheader'],
               capture_output=True, timeout=10).stdout.strip()
    if busy:
        raise RuntimeError('GPUs have existing compute processes; refusing to disturb them: ' + busy)


