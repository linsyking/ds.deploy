def config():
    cfg = json.loads(CONFIG_PATH.read_text())
    allowed = {'10.78.202.30': 's04-p1-dgx-02-c02', '10.78.202.32': 's04-p1-dgx-02-c04'}
    if allowed.get(cfg['host']) != cfg['hostname']:
        raise RuntimeError('The deployment target must be the configured c02 or c04 hostname/IP pair')
    if not 0 < cfg['mem_fraction_static'] < 1:
        raise ValueError('mem_fraction_static must be between zero and one')
    if cfg['chunked_prefill_size'] <= 0 or cfg['chunked_prefill_size'] % 256:
        raise ValueError('chunked_prefill_size must be a positive multiple of 256')
    if not isinstance(cfg.get('default_thinking', False), bool):
        raise ValueError('default_thinking must be true or false')
    if not isinstance(cfg.get('enforce_thinking_budget', False), bool):
        raise ValueError('enforce_thinking_budget must be true or false')
    if not isinstance(cfg.get('enable_web_search', False), bool):
        raise ValueError('enable_web_search must be true or false')
    effort = cfg.get('default_reasoning_effort', 'high')
    if effort not in ('low', 'high', 'max') and not (type(effort) is int and 1 <= effort <= 100):
        raise ValueError('default_reasoning_effort must be low/high/max or an integer 1-100')
    return cfg


def on_server(cfg):
    return socket.gethostname().split('.')[0] == cfg['hostname']


def run(command, **kwargs):
    return subprocess.run([str(v) for v in command], check=True, text=True, **kwargs)


def tmux(*args, check=True, capture=False):
    return subprocess.run([TMUX, '-S', str(SOCKET), *map(str, args)], check=check,
                          text=True, stdout=subprocess.PIPE if capture else subprocess.DEVNULL,
                          stderr=subprocess.PIPE if capture else subprocess.DEVNULL)


def session_exists():
    return tmux('has-session', '-t', SESSION, check=False).returncode == 0


def proc_info(pid):
    try:
        fields = Path(f'/proc/{pid}/stat').read_text().rpartition(')')[2].split()
        return {'pid': int(pid), 'state': fields[0], 'pgid': int(fields[2]), 'start_ticks': fields[19]}
    except (FileNotFoundError, ProcessLookupError, PermissionError):
        return None


def group_members(pgid):
    found = []
    for path in Path('/proc').iterdir():
        if path.name.isdigit():
            item = proc_info(path.name)
            if item and item['pgid'] == pgid and item['state'] != 'Z':
                found.append(item)
    return found


def tracked_state():
    return json.loads(STATE.read_text()) if STATE.exists() else None


def state_is_alive(state):
    if not state:
        return False
    info = proc_info(state['pid'])
    return bool(info and info['state'] != 'Z' and info['start_ticks'] == state['start_ticks'])


@contextlib.contextmanager
def locked():
    RUNS.mkdir(exist_ok=True)
    with (RUNS / 'controller.lock').open('a') as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield


def request(cfg, path, timeout=5):
    req = urllib.request.Request(f'http://{cfg["host"]}:{cfg["port"]}{path}', headers=auth_headers())
    with OPENER.open(req, timeout=timeout) as response:
        return response.read()


def healthy(cfg):
    try:
        request(cfg, '/health', timeout=3)
        return True
    except (OSError, urllib.error.URLError):
        return False


def sync(cfg):
    if on_server(cfg):
        print(f'Already on {cfg["hostname"]}; runtime files are local.')
        return
    run(['ssh', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10', cfg['host'],
         shlex.join(['mkdir', '-p', str(ROOT)])], timeout=15)
    files = [ROOT / name for name in RUNTIME_FILES if (ROOT / name).exists()]
    run(['scp', '-q', *files, f'{cfg["host"]}:{ROOT}/'], timeout=60)
    run(['ssh', '-o', 'BatchMode=yes', cfg['host'],
         shlex.join(['chmod', '+x', str(ROOT / 'ds41ctl'), str(ROOT / 'sglang_load.py')])], timeout=15)
    print(f'Runtime files synchronized to {cfg["hostname"]}; model weights and environments are untouched.')


def preflight(cfg):
    python = ROOT / '.venvs/sglang/bin/python'
    for path in [python, Path(TMUX), AUTH_CONFIG, API_KEY, Path(cfg['model_path']) / '.checkpoint-verified.json']:
        if not path.exists():
            raise RuntimeError(f'Required file is missing: {path}')
    if cfg.get('enable_web_search', False) and (not EXA_API_KEY.exists() or not EXA_API_KEY.read_text().strip()):
        raise RuntimeError('Web search requires a credential in .secrets/exa-api-key')
    probe = socket.socket()
    try:
        probe.settimeout(1)
        if probe.connect_ex((cfg['host'], cfg['port'])) == 0:
            raise RuntimeError('The configured port is already occupied by an untracked service')
    finally:
        probe.close()
    diagnostic = run(['nvidia-smi', '-q', '-x'], capture_output=True, timeout=10)
    gpus = ET.fromstring(diagnostic.stdout).findall('gpu')
    if len(gpus) != 4:
        raise RuntimeError(f'Expected four GPUs on the configured node; found {len(gpus)}')
    for index, gpu in enumerate(gpus):
        action = gpu.findtext('gpu_recovery_action', 'Unknown')
        if action != 'None':
            raise RuntimeError(f'GPU {index} recovery action is {action}; refusing to launch')
    busy = run(['nvidia-smi', '--query-compute-apps=pid,process_name', '--format=csv,noheader'],
               capture_output=True, timeout=10).stdout.strip()
    if busy:
        raise RuntimeError('GPUs have existing compute processes; refusing to disturb them: ' + busy)


def launch_environment(cfg):
    venv = ROOT / '.venvs/sglang'
    site = next((venv / 'lib').glob('python*/site-packages'))
    cuda = site / 'nvidia/cu13'
    cache = RUNS / 'kernel-cache/sglang'
    env = os.environ.copy()
    env.update(CUDA_HOME=str(cuda), CUDA_PATH=str(cuda),
               PATH=f'{cuda}/bin:{venv}/bin:/scratch_local/user_data/yiming/.local/bin:' + env.get('PATH', ''),
               LD_LIBRARY_PATH=f'{cuda}/lib:' + env.get('LD_LIBRARY_PATH', ''),
               TMPDIR=str(RUNS / 'tmp'), HF_HOME='/scratch_local/user_data/yiming/.cache/huggingface',
               HF_HUB_OFFLINE='1', HF_HUB_DISABLE_TELEMETRY='1', TOKENIZERS_PARALLELISM='false',
               OMP_NUM_THREADS='8', CUDA_VISIBLE_DEVICES='0,1,2,3', NCCL_DEBUG='WARN',
               XDG_CACHE_HOME=str(cache / '.cache'), SGLANG_CACHE_DIR=str(cache / '.cache/sglang'),
               SGLANG_JIT_CACHE_DIR=str(cache / '.cache/sglang/jit'),
               SGLANG_DG_CACHE_DIR=str(cache / '.cache/sglang/deep_gemm'),
               DG_JIT_CACHE_DIR=str(cache / '.cache/sglang/deep_gemm'),
               FLASHINFER_WORKSPACE_BASE=str(cache), TRITON_CACHE_DIR=str(cache / '.triton/cache'),
               CUDA_CACHE_PATH=str(cache / '.nv/ComputeCache'),
               CC='/usr/bin/gcc-12', CXX='/usr/bin/g++-12')
    for version in ['12', '13', '11']:
        cc, cxx = shutil.which('gcc-' + version), shutil.which('g++-' + version)
        if cc and cxx:
            env.update(CC=cc, CXX=cxx)
            break
    else:
        raise RuntimeError('A matching GCC/G++ 12, 13, or 11 compiler pair is required')
    env.pop('DS41_THINKING_BUDGET', None)
    env.pop('SGLANG_MAX_THINK_TOKENS', None)
    env.pop('EXA_API_KEY', None)
    if cfg.get('enable_web_search', False):
        env['EXA_API_KEY'] = EXA_API_KEY.read_text().strip()
    if cfg.get('enforce_thinking_budget', False):
        env['DS41_THINKING_BUDGET'] = '1'
        # Enables native budget filtering. Explicit budgets override this
        # unreachable ceiling; ordinary requests skip the strict grammar.
        env['SGLANG_MAX_THINK_TOKENS'] = str(cfg['context_length'])
    for key in ['HF_TOKEN', 'NCCL_DEBUG_SUBSYS', 'http_proxy', 'https_proxy', 'all_proxy',
                'HTTP_PROXY', 'HTTPS_PROXY', 'ALL_PROXY', 'SGLANG_TEXT_ONLY', 'SGLANG_HIDE_THINKING']:
        env.pop(key, None)
    for key in ['TMPDIR', 'XDG_CACHE_HOME', 'SGLANG_CACHE_DIR', 'SGLANG_JIT_CACHE_DIR',
                'SGLANG_DG_CACHE_DIR', 'TRITON_CACHE_DIR', 'CUDA_CACHE_PATH']:
        Path(env[key]).mkdir(parents=True, exist_ok=True)
    return env


def serve(cfg):
    if not on_server(cfg):
        raise RuntimeError('The engine must run on the configured server hostname')
    if os.getpgrp() != os.getpid():
        os.setpgrp()
    env = launch_environment(cfg)
    command = [str(ROOT / '.venvs/sglang/bin/python'), str(ROOT / 'ds41ctl'), '_engine',
               '--config', str(AUTH_CONFIG),
               '--model-path', cfg['model_path'], '--served-model-name', cfg['served_model_name'],
               '--host', cfg['host'], '--port', str(cfg['port']), '--tp', '4', '--ep-size', '4',
               '--enable-multimodal', '--context-length', str(cfg['context_length']),
               '--mem-fraction-static', str(cfg['mem_fraction_static']),
               '--max-running-requests', str(cfg['max_running_requests']),
               '--chunked-prefill-size', str(cfg['chunked_prefill_size']),
               '--cuda-graph-max-bs-decode', str(cfg['cuda_graph_max_bs_decode']),
               '--kv-cache-dtype', 'fp8_e4m3', '--reasoning-parser', 'auto', '--tool-call-parser', 'auto',
               '--default-chat-template-kwargs', json.dumps({
                   'thinking': cfg.get('default_thinking', False),
                   'reasoning_effort': cfg.get('default_reasoning_effort', 'high')}),
               '--enable-metrics', '--enable-cache-report', '--enable-decoder-swa-bounded-replay',
               '--speculative-algorithm', 'DSPARK',
               '--speculative-dspark-block-size', str(cfg['speculative_dspark_block_size'])]
    if cfg.get('enforce_thinking_budget', False):
        command.append('--enable-strict-thinking')
    state = dict(proc_info(os.getpid()), command=command, config=cfg, started_at=time.time(),
                 log=str(LOG), cache_root=str(RUNS / 'kernel-cache/sglang'))
    temporary = STATE.with_suffix('.tmp')
    temporary.write_text(json.dumps(state, indent=2) + chr(10))
    temporary.replace(STATE)
    print('LAUNCH ' + json.dumps(command), flush=True)
    os.execve(command[0], command, env)


def engine():
    # Use the native launcher and native authentication. Keys stay out of argv.
    from sglang.launch_server import run_server
    from sglang.srt.plugins import load_plugins
    from sglang.srt.server_args import prepare_server_args
    from sglang.srt.utils import kill_process_tree
    load_plugins()
    server_args = prepare_server_args(sys.argv[2:])
    if config().get('enable_web_search', False):
        from web_search import install
        install(api_key=API_KEY.read_text().strip(), exa_api_key=EXA_API_KEY.read_text().strip())
    try:
        run_server(server_args)
    finally:
        kill_process_tree(os.getpid(), include_parent=False)


def start(cfg, no_wait):
    os.umask(0o077)
    with locked():
        state = tracked_state()
        if session_exists() or state_is_alive(state):
            if healthy(cfg):
                print(f'Already healthy: http://{cfg["host"]}:{cfg["port"]}/v1')
                return
            raise RuntimeError('An owned service is starting or unhealthy; inspect status/logs before restarting')
        if state and group_members(state['pgid']):
            raise RuntimeError('Owned child processes remain; run stop before starting')
        preflight(cfg)
        (ROOT / 'logs').mkdir(exist_ok=True)
        if LOG.exists():
            stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
            LOG.rename(ROOT / 'logs' / f'sglang-{stamp}.log')
        command = 'exec ' + shlex.join([sys.executable, str(ROOT / 'ds41ctl'), '_serve'])
        command += ' > ' + shlex.quote(str(LOG)) + ' 2>&1'
        tmux('new-session', '-d', '-s', SESSION, '-c', ROOT, command)
    print(f'Started {cfg["hostname"]} TP4 with vision. Log: {LOG}', flush=True)
    if no_wait:
        return
    deadline = time.monotonic() + cfg['startup_timeout_seconds']
    report_at = 0
    while time.monotonic() < deadline:
        if healthy(cfg):
            print(f'Ready: http://{cfg["host"]}:{cfg["port"]}/v1; model={cfg["served_model_name"]}')
            return
        if not session_exists():
            raise RuntimeError('Engine exited during startup; run ds41ctl logs')
        if time.monotonic() >= report_at:
            print('Waiting for model loading, kernel warmup, and vision initialization...', flush=True)
            report_at = time.monotonic() + 30
        time.sleep(5)
    raise RuntimeError('Readiness timed out; service was left running. Inspect status/logs before restarting.')


def stop():
    with locked():
        state = tracked_state()
        if state:
            info = proc_info(state['pid'])
            if info and info['start_ticks'] != state['start_ticks']:
                raise RuntimeError('Tracked PID was reused; refusing to signal it')
            if group_members(state['pgid']):
                os.killpg(state['pgid'], signal.SIGTERM)
                deadline = time.monotonic() + 30
                while group_members(state['pgid']) and time.monotonic() < deadline:
                    time.sleep(0.5)
                if group_members(state['pgid']):
                    os.killpg(state['pgid'], signal.SIGKILL)
                    deadline = time.monotonic() + 10
                    while group_members(state['pgid']) and time.monotonic() < deadline:
                        time.sleep(0.5)
                if group_members(state['pgid']):
                    raise RuntimeError('Owned processes remain after termination; inspect driver/process state')
        if session_exists():
            tmux('kill-session', '-t', SESSION)
        print('Owned DeepSeek service stopped. Logs and model files are preserved.')


def status(cfg):
    state = tracked_state()
    is_healthy = healthy(cfg)
    print(f'API: {"healthy" if is_healthy else "not ready"} (http://{cfg["host"]}:{cfg["port"]}/v1)')
    print(f'Tmux: {"up" if session_exists() else "down"}; owned engine: {"up" if state_is_alive(state) else "down"}')
    if state and state_is_alive(state):
        live = state['config']
        print(f'Model: {live["served_model_name"]}; TP4 / EP4; vision enabled; context {live["context_length"]:,}')
        print(f'Max running: {live["max_running_requests"]}; prefill chunk: {live["chunked_prefill_size"]}; '
              f'static memory: {live["mem_fraction_static"]}; DSpark block: {live["speculative_dspark_block_size"]}')
        print(f'Thinking default: {live.get("default_thinking", False)}; '
              f'effort: {live.get("default_reasoning_effort", "high")} (request overrides take precedence)')
        print(f'Explicit thinking budgets: {live.get("enforce_thinking_budget", False)}')
        print(f'Anthropic web search: {"Exa" if live.get("enable_web_search", False) else "disabled"}')
        print(f'PID: {state["pid"]}; log: {LOG}')
    return 0 if is_healthy and state_is_alive(state) else 1


def api_json(cfg, path, payload):
    req = urllib.request.Request(f'http://{cfg["host"]}:{cfg["port"]}{path}',
        data=json.dumps(payload).encode(), headers={'Content-Type': 'application/json',
                                                   'anthropic-version': '2023-06-01', **auth_headers()})
    try:
        with OPENER.open(req, timeout=300) as response:
            return json.load(response)
    except urllib.error.HTTPError as error:
        raise RuntimeError(f'HTTP {error.code}: {error.read(1500).decode(errors="replace")}') from error


def api_stream(cfg, payload):
    req = urllib.request.Request(f'http://{cfg["host"]}:{cfg["port"]}/v1/messages',
        data=json.dumps(dict(payload, stream=True)).encode(), headers={
            'Content-Type': 'application/json', 'anthropic-version': '2023-06-01', **auth_headers()})
    blocks = {}
    partial = {}
    events = []
    with OPENER.open(req, timeout=300) as response:
        for line in response:
            if not line.startswith(b'data:'):
                continue
            value = line[5:].strip()
            if not value or value == b'[DONE]':
                continue
            event = json.loads(value)
            events.append(event)
            kind = event.get('type')
            if kind == 'error':
                raise RuntimeError('Streaming API error: ' + json.dumps(event))
            index = event.get('index', 0)
            if kind == 'content_block_start':
                blocks[index] = dict(event['content_block'])
            elif kind == 'content_block_delta':
                delta = event.get('delta', {})
                if delta.get('type') == 'text_delta':
                    blocks.setdefault(index, {'type': 'text', 'text': ''})
                    blocks[index]['text'] = blocks[index].get('text', '') + delta.get('text', '')
                elif delta.get('type') == 'input_json_delta':
                    partial[index] = partial.get(index, '') + delta.get('partial_json', '')
                elif delta.get('type') == 'thinking_delta':
                    blocks.setdefault(index, {'type': 'thinking', 'thinking': ''})
                    blocks[index]['thinking'] = blocks[index].get('thinking', '') + delta.get('thinking', '')
                elif delta.get('type') == 'signature_delta':
                    blocks.setdefault(index, {'type': 'thinking', 'thinking': ''})
                    blocks[index]['signature'] = delta.get('signature', '')
    for index, raw in partial.items():
        blocks[index]['input'] = json.loads(raw)
    return {'content': [blocks[index] for index in sorted(blocks)], 'events': events}


def tunnel_state():
    return json.loads(FRPC_STATE.read_text()) if FRPC_STATE.exists() else None


def tunnel_status(cfg):
    state = tunnel_state()
    alive = state_is_alive(state)
    print('FRPC: ' + ('running' if alive else 'stopped'))
    print(f'Forward: server port 8312 -> {cfg["host"]}:{cfg["port"]}')
    print('Server-local API: http://127.0.0.1:8312/v1 on ssh.linsyking.com')
    print('Transport proxy: http://127.0.0.1:18080; log: ' + str(FRPC_LOG))
    if FRPC_LOG.exists():
        for line in FRPC_LOG.read_text(errors='replace').splitlines()[-6:]:
            print(line)
    return 0 if alive else 1


def tunnel_start(cfg):
    os.umask(0o077)
    with locked():
        if state_is_alive(tunnel_state()):
            return tunnel_status(cfg)
        for path in [FRPC_CONFIG, API_KEY, LOCAL_BIN / 'frpc', LOCAL_BIN / 'gost']:
            if not path.exists():
                raise RuntimeError('Required tunnel file is missing: ' + str(path))
        tunnel_cfg = tomllib.loads(FRPC_CONFIG.read_text())
        routes = [route for route in tunnel_cfg.get('proxies', []) if route.get('remotePort') == 8312]
        if len(routes) != 1 or routes[0].get('type') != 'tcp' or routes[0].get('localIP') != cfg['host'] or routes[0].get('localPort') != cfg['port']:
            raise RuntimeError('FRPC port 8312 must target the configured SGLang API at '
                               + f'{cfg["host"]}:{cfg["port"]}; update .secrets/frpc.toml')
        if not healthy(cfg):
            raise RuntimeError('Wait for the API to become healthy before exposing it')
        request(cfg, '/v1/models')
        try:
            with OPENER.open(f'http://{cfg["host"]}:{cfg["port"]}/v1/models', timeout=5):
                raise RuntimeError('Refusing to expose an API that accepts unauthenticated requests')
        except urllib.error.HTTPError as error:
            if error.code != 401:
                raise RuntimeError('Expected an unauthenticated HTTP 401') from error
        run([LOCAL_BIN / 'frpc', 'verify', '-c', FRPC_CONFIG], capture_output=True, timeout=15)
        with socket.socket() as probe:
            probe.settimeout(1)
            proxy_up = probe.connect_ex(('127.0.0.1', 18080)) == 0
        if not proxy_up:
            subprocess.Popen(['nohup', str(LOCAL_BIN / 'gost'), '-L', GOST_URL],
                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                start_new_session=True)
            time.sleep(1)
        # Only launch FRPC after a real request through the requested proxy succeeds.
        proxy = urllib.request.build_opener(urllib.request.ProxyHandler(
            {'https': 'http://127.0.0.1:18080'}))
        req = urllib.request.Request('https://1.1.1.1/dns-query?name=ssh.linsyking.com&type=A',
            headers={'Accept': 'application/dns-json'})
        with proxy.open(req, timeout=20) as response:
            dns = json.load(response)
            if dns.get('Status') != 0 or not dns.get('Answer'):
                raise RuntimeError('DNS-over-HTTPS resolution failed')
        with FRPC_LOG.open('ab') as log:
            child = subprocess.Popen(['nohup', str(LOCAL_BIN / 'frpc'), '-c', str(FRPC_CONFIG)],
                cwd=ROOT, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT,
                start_new_session=True)
        time.sleep(1)
        info = proc_info(child.pid)
        if not info or info['state'] == 'Z':
            raise RuntimeError('FRPC exited; inspect ' + str(FRPC_LOG))
        FRPC_STATE.write_text(json.dumps(dict(info, started_at=time.time()), indent=2) + chr(10))
    return tunnel_status(cfg)


def tunnel_stop():
    with locked():
        state = tunnel_state()
        if state_is_alive(state):
            os.killpg(state['pgid'], signal.SIGTERM)
            deadline = time.monotonic() + 10
            while state_is_alive(state) and time.monotonic() < deadline:
                time.sleep(0.2)
            if state_is_alive(state):
                raise RuntimeError('FRPC did not exit after SIGTERM')
        print('FRPC stopped. The loopback GOST proxy is left available.')


def vision_fixture():
    """Generate a random image-only four-digit code and two colored rectangles."""
    code = str(1000 + secrets.randbelow(9000))
    width, height = 560, 320
    pixels = bytearray([255] * (width * height * 3))
    def rectangle(x0, y0, x1, y1, color):
        row = bytes(color) * (x1 - x0)
        for y in range(y0, y1):
            offset = (y * width + x0) * 3
            pixels[offset:offset + len(row)] = row
    rectangle(35, 25, 255, 165, (225, 25, 25))
    rectangle(305, 25, 525, 165, (25, 65, 225))
    font = {
        '0': ['11111','10001','10011','10101','11001','10001','11111'],
        '1': ['00100','01100','00100','00100','00100','00100','01110'],
        '2': ['11111','00001','00001','11111','10000','10000','11111'],
        '3': ['11111','00001','00001','01111','00001','00001','11111'],
        '4': ['10001','10001','10001','11111','00001','00001','00001'],
        '5': ['11111','10000','10000','11111','00001','00001','11111'],
        '6': ['11111','10000','10000','11111','10001','10001','11111'],
        '7': ['11111','00001','00010','00100','01000','01000','01000'],
        '8': ['11111','10001','10001','11111','10001','10001','11111'],
        '9': ['11111','10001','10001','11111','00001','00001','11111'],
    }
    for digit_index, digit in enumerate(code):
        for y, row in enumerate(font[digit]):
            for x, bit in enumerate(row):
                if bit == '1':
                    x0, y0 = 135 + digit_index * 75 + x * 11, 205 + y * 11
                    rectangle(x0, y0, x0 + 11, y0 + 11, (0, 0, 0))
    def chunk(kind, data):
        return struct.pack('!I', len(data)) + kind + data + struct.pack('!I', zlib.crc32(kind + data))
    scanlines = b''.join(b'\x00' + pixels[y * width * 3:(y + 1) * width * 3] for y in range(height))
    png = b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', struct.pack('!2I5B', width, height, 8, 2, 0, 0, 0))
    return code, png + chunk(b'IDAT', zlib.compress(scanlines)) + chunk(b'IEND', b'')


