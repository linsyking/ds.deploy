def redact_log_records():
    # Also runs when multiprocessing imports this entrypoint in child processes.
    keys = tuple(path.read_text().strip() for path in (API_KEY, EXA_API_KEY)
                 if path.exists() and path.read_text().strip())
    if not keys:
        return
    def redact(value):
        for key in keys:
            value = value.replace(key, '<redacted>')
        return value
    class RedactedStream:
        def __init__(self, stream):
            self.stream = stream
        def write(self, value):
            self.stream.write(redact(value))
            return len(value)
        def flush(self):
            return self.stream.flush()
        def __getattr__(self, name):
            return getattr(self.stream, name)
    sys.stderr = RedactedStream(sys.stderr)
    sys.stdout = RedactedStream(sys.stdout)
    previous = logging.getLogRecordFactory()
    def factory(*args, **kwargs):
        record = previous(*args, **kwargs)
        message = record.getMessage()
        cleaned = redact(message)
        if cleaned != message:
            record.msg = cleaned
            record.args = ()
        return record
    logging.setLogRecordFactory(factory)


redact_log_records()

