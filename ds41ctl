def check_reasoning(cfg):
    if not healthy(cfg):
        raise RuntimeError('Server is not healthy; wait for startup before checking reasoning')
    info = json.loads(request(cfg, '/server_info', timeout=15))
    expected = {'thinking': cfg.get('default_thinking', False),
                'reasoning_effort': cfg.get('default_reasoning_effort', 'high')}
    if info.get('default_chat_template_kwargs') != expected:
        raise RuntimeError('Live thinking defaults differ from serving.json; apply the configuration first')
    destination = ROOT / 'audit' / ('reasoning-check-' + datetime.datetime.now().strftime('%Y%m%d-%H%M%S'))
    destination.mkdir(parents=True)
    prompt = ('How many 20-character strings over A, B, and C contain exactly six As, '
              'seven Bs, and seven Cs, with no two As adjacent? Give the exact integer '
              'and a brief explanation.')
    base = {'model': cfg['served_model_name'], 'messages': [{'role': 'user', 'content': prompt}],
            'max_tokens': 4096, 'temperature': 0}
    results = []
    def record(name, passed, detail):
        results.append({'test': name, 'passed': bool(passed), **detail})
        (destination / 'summary.json').write_text(json.dumps(
            {'live_defaults': expected, 'synthetic_prompt': prompt, 'tests': results}, indent=2) + chr(10))
        print(name + ': ' + ('PASS' if passed else 'FAIL'), flush=True)
    cases = [
        ('anthropic_default', {}, expected['thinking']),
        ('anthropic_max_only', {'output_config': {'effort': 'max'}}, expected['thinking']),
        ('anthropic_explicit_max', {'thinking': {'type': 'adaptive'}, 'output_config': {'effort': 'max'}}, True),
        ('anthropic_explicit_off', {'thinking': {'type': 'disabled'}, 'output_config': {'effort': 'max'}}, False),
    ]
    for name, options, thinking in cases:
        response = api_json(cfg, '/v1/messages', dict(base, **options))
        blocks = response.get('content', [])
        count = sum(len(b.get('thinking', '')) for b in blocks if b.get('type') == 'thinking')
        record(name, (count > 0) == thinking and response.get('stop_reason') == 'end_turn',
               {'options': options, 'reasoning_chars': count, 'usage': response.get('usage')})
    streamed = api_stream(cfg, dict(base, output_config={'effort': 'max'}))
    count = sum(len(b.get('thinking', '')) for b in streamed['content'] if b.get('type') == 'thinking')
    record('anthropic_streaming_max', (count > 0) == expected['thinking'] and
           any(e.get('type') == 'message_stop' for e in streamed['events']), {'reasoning_chars': count})
    prompts = []
    for name, options in [
        ('openai_default', {}),
        ('openai_explicit_configured', {'reasoning_effort': expected['reasoning_effort'],
                                       'chat_template_kwargs': {'thinking': expected['thinking']}}),
    ]:
        response = api_json(cfg, '/v1/chat/completions', dict(base, return_prompt_token_ids=True, **options))
        choice = response['choices'][0]
        count = len(choice['message'].get('reasoning_content') or '')
        ids = choice.get('prompt_token_ids')
        prompts.append(ids)
        record(name, (count > 0) == expected['thinking'] and choice.get('finish_reason') == 'stop',
               {'reasoning_chars': count, 'usage': response.get('usage'), 'prompt_token_ids': ids})
    record('default_prompt_matches_explicit', bool(prompts[0]) and prompts[0] == prompts[1],
           {'prompt_tokens': len(prompts[0] or [])})
    response = api_json(cfg, '/v1/chat/completions', dict(base, reasoning_effort='none'))
    count = len(response['choices'][0]['message'].get('reasoning_content') or '')
    record('openai_explicit_off', count == 0 and response['choices'][0].get('finish_reason') == 'stop',
           {'reasoning_chars': count, 'usage': response.get('usage')})
    print('Reasoning verification: ' + str(destination))
    return 0 if len(results) == 9 and all(r['passed'] for r in results) else 1


def check_budget(cfg):
    from concurrent.futures import ThreadPoolExecutor
    from transformers import AutoTokenizer
    if not cfg.get('enforce_thinking_budget') or not healthy(cfg):
        raise RuntimeError('Enable thinking budgets and wait for server readiness first')
    tokenizer = AutoTokenizer.from_pretrained(cfg['model_path'], trust_remote_code=True, local_files_only=True)
    destination = ROOT / 'audit' / ('thinking-budget-' + datetime.datetime.now().strftime('%Y%m%d-%H%M%S'))
    destination.mkdir(parents=True)
    results = []
    prompt = ('Solve this Sudoku without tools. Zero means blank. Check every row, column, and 3x3 box. '
              'Return the nine completed rows.\n100007090\n030020008\n009600500\n005300900\n'
              '010080002\n600004000\n300000010\n040000007\n007000300')
    base = {'model': cfg['served_model_name'], 'messages': [{'role': 'user', 'content': prompt}],
            'max_tokens': 4096, 'temperature': 0}
    def record(name, passed, **detail):
        results.append({'test': name, 'passed': bool(passed), **detail})
        (destination / 'summary.json').write_text(json.dumps({'prompt': prompt, 'tests': results}, indent=2) + chr(10))
        print(name + ': ' + ('PASS' if passed else 'FAIL'), flush=True)
    end_ids = tokenizer.encode('</think>', add_special_tokens=False)
    # Raw generated IDs prove the boundary without relying on text re-tokenization
    # or the engine's reasoning-usage estimate, which can include framing tokens.
    for budget in [16, 128]:
        response = api_json(cfg, '/v1/chat/completions', dict(base, reasoning_effort='max',
            custom_params={'thinking_budget': budget}, return_token_ids=True))
        choice = response['choices'][0]
        ids = choice.get('response_token_ids') or []
        boundary = next((i for i in range(len(ids)) if ids[i:i+len(end_ids)] == end_ids), None)
        record(f'raw_boundary_{budget}', boundary == budget and bool(choice['message'].get('content')),
               boundary=boundary, budget=budget, response=response)
    def probe(item):
        budget, streaming = item
        payload = dict(base, thinking={'type': 'enabled', 'budget_tokens': budget})
        start = time.monotonic()
        response = api_stream(cfg, payload) if streaming else api_json(cfg, '/v1/messages', payload)
        reasoning = ''.join(b.get('thinking', '') for b in response.get('content', []))
        answer = ''.join(b.get('text', '') for b in response.get('content', []))
        count = len(tokenizer.encode(reasoning, add_special_tokens=False))
        ended = (any(e.get('type') == 'message_stop' for e in response['events']) if streaming
                 else response.get('stop_reason') == 'end_turn')
        return budget, streaming, count, bool(answer), ended, time.monotonic()-start, response
    # Mixed budgets in the same batch check isolation and DSpark mask rollback.
    with ThreadPoolExecutor(max_workers=4) as pool:
        for budget, streaming, count, answer, ended, elapsed, response in pool.map(
                probe, [(1024, False), (1024, True), (2048, False), (2048, True)]):
            record(f'anthropic_{budget}_{"stream" if streaming else "json"}',
                   0 < count <= budget and answer and ended, budget=budget,
                   retokenized_reasoning_tokens=count, elapsed_seconds=elapsed, response=response)
    options = {'model': cfg['served_model_name'], 'max_tokens': 4096, 'temperature': 0,
               'thinking': {'type': 'enabled', 'budget_tokens': 1024}}
    tools = [{'name': 'fixture_lookup', 'description': 'Return the value for a key.',
              'input_schema': {'type': 'object', 'properties': {'key': {'type': 'string'}}, 'required': ['key']}}]
    messages = [{'role': 'user', 'content': 'Call fixture_lookup with key deployment and report its returned value.'}]
    first = api_stream(cfg, dict(options, messages=messages, tools=tools,
                                tool_choice={'type': 'tool', 'name': 'fixture_lookup'}))
    calls = [b for b in first['content'] if b.get('type') == 'tool_use']
    valid = len(calls) == 1 and calls[0].get('input', {}).get('key') == 'deployment'
    record('budget_tool_call', valid, response=first)
    if valid:
        value = 'BUDGET_OK_' + secrets.token_hex(4)
        messages += [{'role': 'assistant', 'content': first['content']}, {'role': 'user', 'content': [
            {'type': 'tool_result', 'tool_use_id': calls[0]['id'], 'content': value}]}]
        second = api_stream(cfg, dict(options, messages=messages, tools=tools))
        record('budget_tool_result', value in ''.join(b.get('text', '') for b in second['content']), response=second)
    code, png = vision_fixture()
    (destination / 'vision.png').write_bytes(png)
    image = {'type': 'image', 'source': {'type': 'base64', 'media_type': 'image/png', 'data': base64.b64encode(png).decode()}}
    response = api_stream(cfg, dict(options, messages=[{'role': 'user', 'content': [image,
        {'type': 'text', 'text': 'Read the four-digit code and the color of the left rectangle. Reply only with code and color.'}]}]))
    answer = ''.join(b.get('text', '') for b in response['content'])
    record('budget_vision', code in answer and 'red' in answer.lower(), expected_code=code, response=response)
    print('Thinking budget verification: ' + str(destination))
    return 0 if len(results) == 9 and all(r['passed'] for r in results) else 1


