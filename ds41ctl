def main():
    if len(sys.argv) > 1 and sys.argv[1] == '_engine':
        engine(); return 0
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['start', 'stop', 'restart', 'status', 'logs', 'sync', 'load', 'check',
                                         'tunnel-start', 'tunnel-stop', 'tunnel-status', '_serve'])
    parser.add_argument('--no-wait', action='store_true', help='Return after starting; inspect status for readiness')
    parser.add_argument('--follow', action='store_true', help='Follow logs until interrupted')
    args = parser.parse_args()
    cfg = config()
    if args.action == 'sync':
        sync(cfg); return 0
    if args.action == 'load':
        return subprocess.call([sys.executable, str(ROOT / 'sglang_load.py')])
    if args.action == 'check':
        return check(cfg)
    if not on_server(cfg):
        if args.action in ['start', 'restart']:
            sync(cfg)
        command = [sys.executable, str(ROOT / 'ds41ctl'), args.action]
        if args.no_wait: command.append('--no-wait')
        if args.follow: command.append('--follow')
        return subprocess.call(['ssh', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10', cfg['host'], shlex.join(command)])
    if args.action == '_serve': serve(cfg)
    elif args.action == 'start': start(cfg, args.no_wait)
    elif args.action == 'stop': stop()
    elif args.action == 'restart': stop(); start(cfg, args.no_wait)
    elif args.action == 'status': return status(cfg)
    elif args.action == 'tunnel-start': return tunnel_start(cfg)
    elif args.action == 'tunnel-stop': tunnel_stop()
    elif args.action == 'tunnel-status': return tunnel_status()
    elif args.action == 'logs':
        print(f'Log: {LOG}', flush=True)
        return subprocess.call(['tail', '-F' if args.follow else '-n', str(LOG) if args.follow else '60',
                                *([] if args.follow else [str(LOG)])])
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (RuntimeError, ValueError, OSError, subprocess.SubprocessError) as error:
        print(f'ERROR: {error}', file=sys.stderr)
        sys.exit(1)
